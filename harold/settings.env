# Harold's non-secret settings for this workspace. COMMITTED: every machine, cloud session and scheduled job
# reads them, so they work with nothing to set up. Precedence: the environment, then ~/.harold/env, then this file.
#
# Only HAROLD_* names are read here, and never one that looks like a credential (KEY, TOKEN, SECRET, PASSWORD).
# Credentials (SUPABASE_*, LINEAR_API_KEY, ...) belong in ~/.harold/env; harold close refuses to commit a key.
#
# Your IANA time zone, e.g. America/Chicago, Europe/London. Unset: the zone of whatever machine runs Harold.
# HAROLD_TZ="America/Chicago"
#
# Weekday time the scheduled morning brief is due (HH:MM, 24-hour, in HAROLD_TZ). Default 06:30.
# HAROLD_BRIEF_TIME="06:30"
#
# Contact types (or labels) whose conversations are never logged as CRM interactions, comma-separated.
# Off by default; for example "team" keeps conversations with your own team out of the CRM.
# HAROLD_NO_LOG_TYPES="team"
#
# Days after which a maintained note counts as stale in related/search (default 30), and an active project
# as quiet in pulse and boot (default 14).
# HAROLD_STALE_DAYS="30"
# HAROLD_PULSE_DAYS="14"
