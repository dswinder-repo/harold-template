{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${QWEN_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/bin/harold\" boot --via=qwen",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${QWEN_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/bin/harold\" close --via=qwen",
            "timeout": 240
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${QWEN_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/bin/harold\" close --final --via=qwen",
            "timeout": 240
          }
        ]
      }
    ]
  },
  "$version": 4
}
