# ── OS / editors ─────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp

# ── Dependencies / build ─────────────────────────────────
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/

# ── Secrets: never in the repo. They live in ~/.harold/env ──
.env
.env.*
*.env
.mcp.json
.cursor/mcp.json
.codex/config.toml
*.key
*.pem
**/credentials.json
**/service-account*.json
# The env templates are meant to be committed: they hold no values.
!.env.example

# ── Harold runtime state (rebuilt or per-machine) ────────
harold/search.db*
harold/active-sessions/*.json
harold/active-sessions/.state/
*.lock/
harold/crm-queue.jsonl.replaying/
harold/*.tmp-*
harold/.brief-job.json
harold/.brief-context.md
.claude/settings.local.json

# ── Obsidian app state (optional viewer; may hold API keys) ──
vault/.obsidian/

# ── The CRM web app (tools/harold-crm, Next.js) ──────────
# node_modules/ and .env.local are covered above.
tools/harold-crm/.next/
tools/harold-crm/out/
tools/harold-crm/coverage/
tools/harold-crm/.vercel/
tools/harold-crm/next-env.d.ts
tools/harold-crm/supabase/.temp/
*.tsbuildinfo
.pnpm-debug.log*
npm-debug.log*
