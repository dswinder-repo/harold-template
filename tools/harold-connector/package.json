{
  "name": "harold-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted remote MCP server for your Harold knowledge base and CRM, usable from any MCP client",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "token": "tsx scripts/mint-token.ts",
    "test:e2e:read": "tsx test/e2e/read.e2e.ts",
    "test:e2e:write": "tsx test/e2e/write.e2e.ts",
    "test:e2e:crm": "tsx test/e2e/crm-read.e2e.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/server": "^2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^26.6.3",
    "hono": "^4.13.12",
    "mcp-handler": "^2.2.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/sdk": "~1.31.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
