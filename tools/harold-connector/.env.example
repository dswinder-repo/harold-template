# Harold connector environment. Set these where the connector runs (for Vercel: Project → Settings →
# Environment Variables, or `vercel env add NAME production`). Never commit real values.

# The private GitHub repository that holds your Harold workspace, as owner/name. Required, no default.
HAROLD_REPO=
# The branch the tools read and commit to.
HAROLD_BRANCH=main

# The only GitHub account accepted. Both are required and both must match.
# Numeric id: `gh api user --jq .id` or https://api.github.com/users/<login>
ALLOWED_GITHUB_LOGIN=
ALLOWED_GITHUB_ID=

# The GitHub OAuth App (Authorization callback URL: <PUBLIC_BASE_URL>/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32 random bytes as 64 hex characters: openssl rand -hex 32
# Encrypts client ids, sign-in state, authorization codes, access and refresh tokens, personal access tokens.
# Changing it signs every client out (reconnect once in each tool) and revokes every personal access token.
TOKEN_KEY=

# The public origin of this deployment, no trailing slash, e.g. https://<your-project>.vercel.app
# For local runs: http://localhost:8787
PUBLIC_BASE_URL=

# Optional. Unset, empty or * (the default): any MCP client can sign in (https redirects on any host,
# app schemes such as cursor:// and vscode://). Loopback (http://127.0.0.1, http://[::1], http://localhost,
# any port) is always accepted. To narrow, list exact https hosts and app schemes (ending in ":"),
# comma-separated, e.g. claude.ai,claude.com,cursor:
ALLOWED_REDIRECT_HOSTS=

# Optional: ids of revoked personal access tokens (printed by `npm run token`), comma-separated.
# Rotating TOKEN_KEY revokes every token at once.
REVOKED_TOKEN_IDS=

# Your IANA time zone, e.g. America/Chicago or Europe/London. Unset or invalid: UTC.
HAROLD_TZ=

# Optional: contact types crm_stale never checks for going quiet (comma-separated). Unset: other.
# Set it empty to check every type.
# HAROLD_NO_CADENCE_TYPES=other

# Optional: author email on the connector's commits. Default: harold-connector@users.noreply.github.com
HAROLD_COMMIT_EMAIL=

# Optional: the CRM (Supabase, schema in tools/harold-mcp/schema.sql). Leave empty to run without it;
# the CRM tools then say "not configured".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Harold's task list is the Supabase tasks table, so the task tools (task_list, task_create, task_update,
# crm_task) use the SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above. They need nothing else.

# Optional: two-way task sync (src/sync). Each tool is optional and independent; any mix works. Leave a tool's
# settings empty to run without it. With none configured the sync routes answer 503 and nothing syncs.
#   SYNC_SECRET            every tool: a shared secret Supabase sends to /sync/*; the same value goes into Supabase
#                          Vault as harold_sync_secret (generate one with: openssl rand -hex 32)
# Linear:
#   LINEAR_API_KEY         a Linear personal API key
#   LINEAR_TEAM_KEY        the team's issue prefix (ENG for ENG-123)
#   LINEAR_WEBHOOK_SECRET  the signing secret Linear shows for the webhook
# Todoist:
#   TODOIST_API_TOKEN      an API token
#   TODOIST_PROJECT        optional: keep the sync to one project (its name)
#   TODOIST_CLIENT_SECRET  optional: your Todoist app's client secret, to verify its webhook
# Asana:
#   ASANA_ACCESS_TOKEN     a personal access token
#   ASANA_WORKSPACE        the workspace's name or gid
#   ASANA_PROJECT          optional: keep the sync to one project (name or gid)
# Notion:
#   NOTION_TOKEN           an internal integration's secret (the database and field mapping are saved with the
#                          sync_setup_notion tool, not here)
#   NOTION_WEBHOOK_SECRET  optional: the webhook verification token, if you prefer it here
SYNC_SECRET=
LINEAR_API_KEY=
LINEAR_TEAM_KEY=
LINEAR_WEBHOOK_SECRET=
TODOIST_API_TOKEN=
TODOIST_PROJECT=
TODOIST_CLIENT_SECRET=
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE=
ASANA_PROJECT=
NOTION_TOKEN=
NOTION_WEBHOOK_SECRET=

# Optional: the calendars (Google), for calendar_list and calendar_events. Leave empty to run
# without them; those two tools then say "not configured". GOOGLE_REFRESH_TOKEN is the sealed value
# the /google/authorize -> /google/callback flow shows once; only the owner-facing flow can mint it,
# and only for a Google account whose email is in ALLOWED_GOOGLE_EMAILS. Read-only scopes only.
# Google consent screen: publish it - "Testing" status refresh tokens expire after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=
GOOGLE_REFRESH_TOKEN=

