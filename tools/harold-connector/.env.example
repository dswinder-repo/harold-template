# Harold connector environment. Set these where the connector runs (for Vercel: Project → Settings →
# Environment Variables, or `vercel env add NAME production`). Never commit real values.

# The private GitHub repository that holds your Harold workspace, as owner/name. Required, no default.
HAROLD_REPO=
# The branch the tools read and commit to.
HAROLD_BRANCH=main

# The only GitHub account accepted. Both are required and both must match.
# Numeric id: `gh api user --jq .id` or https://api.github.com/users/<login>
ALLOWED_GITHUB_LOGIN=
ALLOWED_GITHUB_ID=

# The GitHub OAuth App (Authorization callback URL: <PUBLIC_BASE_URL>/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32 random bytes as 64 hex characters: openssl rand -hex 32
# Encrypts client ids, sign-in state, authorization codes, access and refresh tokens, personal access tokens.
# Changing it signs every client out (reconnect once in each tool) and revokes every personal access token.
TOKEN_KEY=

# The public origin of this deployment, no trailing slash, e.g. https://<your-project>.vercel.app
# For local runs: http://localhost:8787
PUBLIC_BASE_URL=

# Optional. Unset, empty or * (the default): any MCP client can sign in (https redirects on any host,
# app schemes such as cursor:// and vscode://). Loopback (http://127.0.0.1, http://[::1], http://localhost,
# any port) is always accepted. To narrow, list exact https hosts and app schemes (ending in ":"),
# comma-separated, e.g. claude.ai,claude.com,cursor:
ALLOWED_REDIRECT_HOSTS=

# Optional: ids of revoked personal access tokens (printed by `npm run token`), comma-separated.
# Rotating TOKEN_KEY revokes every token at once.
REVOKED_TOKEN_IDS=

# Your IANA time zone, e.g. America/Chicago or Europe/London. Unset or invalid: UTC.
HAROLD_TZ=

# Optional, empty by default: contact types (comma-separated) whose conversations are never logged
# as CRM interactions, e.g. team. Same setting as in ~/.harold/env for bin/harold and harold-mcp.
HAROLD_NO_LOG_TYPES=

# Optional: author email on the connector's commits. Default: harold-connector@users.noreply.github.com
HAROLD_COMMIT_EMAIL=

# Optional: the CRM (Supabase, schema in tools/harold-mcp/schema.sql). Leave empty to run without it;
# the CRM tools then say "not configured".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
