# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase (required unless you run demo mode) ────────────────────────────
# Project Settings > API (or "Connect") in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or, on older projects, the anon key.
# It is safe in the browser: the members-only policies mean it reads nothing on its own.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── AI features (optional) ──────────────────────────────────────────────────
# Contact research, enrichment and meeting prep use Google Gemini with search
# grounding, because its free tier covers them. Get a free key (sign in with a
# Google account, no card needed) at https://aistudio.google.com/apikey
# Leave empty and the app works without them; the AI buttons just report that
# AI is off. Server-side only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# ── Types you never log (optional) ──────────────────────────────────────────
# Comma-separated contact types whose conversations you never log, for example
# "team" if you choose never to log conversations with your own team. Warmth
# decay skips them (their last-contact date would otherwise look stale forever).
# Empty by default. Same meaning as HAROLD_NO_LOG_TYPES in a Harold workspace.
NEXT_PUBLIC_HAROLD_NO_LOG_TYPES=

# ── Demo mode (optional) ────────────────────────────────────────────────────
# 1 = run on invented in-memory data, no Supabase needed. Use `pnpm dev:demo`.
# Never set this on a real deployment.
NEXT_PUBLIC_DEMO_MODE=0

# Do NOT put your Supabase service role / secret key here. The web app never
# needs it. Only Harold's MCP server uses it, and it lives in that server's own
# environment (for Harold: ~/.harold/env), never in this app or in the browser.
