#!/usr/bin/env node
/*
 * harold-codex-auth — keeps a Codex ChatGPT sign-in usable in scheduled cloud jobs.
 *
 *   harold-codex-auth restore   write $CODEX_HOME/auth.json (default ~/.codex) for this run
 *   harold-codex-auth save      after the run: if Codex renewed the sign-in, encrypt the new copy for the cache
 *
 * Why this exists. A ChatGPT sign-in (`codex login`) is an OAuth session. Codex renews it by itself, and
 * each renewal hands back a new refresh token and retires the old one (the auth server rejects a reused one
 * with `refresh_token_reused`). The repository secret CODEX_AUTH_JSON is a snapshot, so after the first
 * renewal it would be stale. The workflows therefore keep the renewed auth.json in the GitHub Actions
 * cache, encrypted, and this program decides which copy a run uses:
 *
 *   restore  1. the cached copy ($RUNNER_TEMP/codex-auth.enc), if it decrypts with the key derived from the
 *               CURRENT secret: it is the newest renewal of that same sign-in;
 *            2. otherwise the secret itself (first run, cache evicted, or you replaced the secret with a
 *               new sign-in: the old cache no longer decrypts, so a new secret always wins).
 *   save     encrypts $CODEX_HOME/auth.json only if it changed during the run, and prints changed=true|false
 *            (also to $GITHUB_OUTPUT) so the workflow saves a new cache entry only when there is one.
 *
 * The encryption key is derived (HKDF-SHA256) from the secret's own contents, so there is no second secret
 * to manage, and whoever can decrypt the cache could already read the secret. AES-256-GCM authenticates
 * the file: a wrong key or a tampered file is rejected, never half-used. Nothing here prints a token.
 *
 * Environment: CODEX_AUTH_JSON (the secret), CODEX_HOME (optional), RUNNER_TEMP (where the .enc and the
 * fingerprint live; defaults to the system temp dir), GITHUB_OUTPUT (optional).
 */
'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');

const INFO = 'harold-codex-auth-v1';

function deriveKey(secret, salt) {
  return Buffer.from(crypto.hkdfSync('sha256', Buffer.from(secret, 'utf8'), salt, Buffer.from(INFO), 32));
}

function encrypt(plaintext, secret) {
  const salt = crypto.randomBytes(16), iv = crypto.randomBytes(12);
  const c = crypto.createCipheriv('aes-256-gcm', deriveKey(secret, salt), iv);
  c.setAAD(Buffer.from(INFO));
  const ct = Buffer.concat([c.update(Buffer.from(plaintext, 'utf8')), c.final()]);
  return JSON.stringify({ v: 1, salt: salt.toString('base64'), iv: iv.toString('base64'), tag: c.getAuthTag().toString('base64'), ct: ct.toString('base64') });
}

// Returns the plaintext, or null when the file is not ours, was made from another secret, or was altered.
function decrypt(blob, secret) {
  try {
    const o = JSON.parse(blob);
    if (o.v !== 1) return null;
    const d = crypto.createDecipheriv('aes-256-gcm', deriveKey(secret, Buffer.from(o.salt, 'base64')), Buffer.from(o.iv, 'base64'));
    d.setAAD(Buffer.from(INFO));
    d.setAuthTag(Buffer.from(o.tag, 'base64'));
    return Buffer.concat([d.update(Buffer.from(o.ct, 'base64')), d.final()]).toString('utf8');
  } catch (_) { return null; }
}

// An auth.json Codex can use: a JSON object carrying ChatGPT tokens (or another stored credential).
function usable(text) {
  try {
    const j = JSON.parse(text);
    return !!(j && typeof j === 'object' && ((j.tokens && j.tokens.refresh_token) || j.personal_access_token || j.agent_identity || j.OPENAI_API_KEY));
  } catch (_) { return false; }
}

const sha = s => crypto.createHash('sha256').update(s).digest('hex');

function paths(env) {
  const home = env.CODEX_HOME || path.join(env.HOME || os.homedir(), '.codex');
  const tmp = env.RUNNER_TEMP || os.tmpdir();
  return { home, auth: path.join(home, 'auth.json'), enc: path.join(tmp, 'codex-auth.enc'), fp: path.join(tmp, 'codex-auth.sha256') };
}

function restore(env = process.env) {
  const secret = (env.CODEX_AUTH_JSON || '').trim();
  if (!secret) return { ok: false, msg: 'CODEX_AUTH_JSON is empty. Add the contents of auth.json from `codex login` as that repository secret.' };
  if (!usable(secret)) return { ok: false, msg: 'CODEX_AUTH_JSON is not a Codex auth.json (expected JSON with "tokens"). Copy the whole file, braces included.' };
  const p = paths(env);
  let text = secret, source = 'the CODEX_AUTH_JSON secret';
  if (fs.existsSync(p.enc)) {
    const cached = decrypt(fs.readFileSync(p.enc, 'utf8'), secret);
    if (cached && usable(cached)) { text = cached; source = 'the renewed sign-in an earlier run saved (Actions cache)'; }
    else source = 'the CODEX_AUTH_JSON secret (the cached copy belongs to an earlier secret, so the secret wins)';
  }
  fs.mkdirSync(p.home, { recursive: true, mode: 0o700 });
  fs.writeFileSync(p.auth, text, { mode: 0o600 });
  fs.chmodSync(p.auth, 0o600);
  fs.writeFileSync(p.fp, sha(text));
  return { ok: true, msg: `Codex sign-in restored from ${source}.` };
}

function save(env = process.env) {
  const secret = (env.CODEX_AUTH_JSON || '').trim();
  const p = paths(env);
  if (!secret) return { ok: false, changed: false, msg: 'CODEX_AUTH_JSON is empty; nothing to save.' };
  if (!fs.existsSync(p.auth)) return { ok: true, changed: false, msg: `No ${p.auth} after the run; nothing to save.` };
  const text = fs.readFileSync(p.auth, 'utf8');
  const before = fs.existsSync(p.fp) ? fs.readFileSync(p.fp, 'utf8').trim() : '';
  if (sha(text) === before) return { ok: true, changed: false, msg: 'Codex did not renew the sign-in during this run; the cache stays as it is.' };
  if (!usable(text)) return { ok: true, changed: false, msg: `${p.auth} changed but is not a usable sign-in; not saving it.` };
  fs.writeFileSync(p.enc, encrypt(text, secret), { mode: 0o600 });
  return { ok: true, changed: true, msg: 'Codex renewed the sign-in during this run; saving the encrypted copy for the next run.' };
}

module.exports = { encrypt, decrypt, usable, restore, save, paths };

if (require.main === module) {
  const cmd = process.argv[2];
  if (cmd === 'restore') {
    const r = restore(); console.log(r.ok ? r.msg : `::error::${r.msg}`); process.exit(r.ok ? 0 : 1);
  } else if (cmd === 'save') {
    const r = save(); console.log(r.ok ? r.msg : `::warning::${r.msg}`);
    if (process.env.GITHUB_OUTPUT) fs.appendFileSync(process.env.GITHUB_OUTPUT, `changed=${r.changed}\n`);
    console.log(`changed=${r.changed}`);
    process.exit(0);
  } else {
    console.error('usage: harold-codex-auth restore | save   (see the comment at the top of this file)'); process.exit(2);
  }
}
