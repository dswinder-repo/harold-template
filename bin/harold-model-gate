#!/usr/bin/env node
/*
 * harold-model-gate: PreToolUse hook that makes spawned sessions and helper agents name their model.
 * Standalone, zero dependencies: copy this one file into any repo and run it as a PreToolUse hook.
 * Source of truth: the Harold starter (bin/harold-model-gate). `bin/harold gate` calls it too.
 *
 * Why: in harnesses where a spawned session or helper inherits the caller's model when none is named, one
 * session on a costly model silently runs every worker on that model. A rule in prose did not stop that.
 *
 * Model-agnostic. Nothing here names a vendor or a model; the workspace says which models are costly:
 *   HAROLD_EXPENSIVE_MODELS  comma-separated substrings of model names that need a deliberate opt-in (default: none)
 *   HAROLD_EXPENSIVE_TAG     the session tag that is that opt-in (default: allow-expensive)
 *   HAROLD_WORKER_MODEL      the model to suggest for workers in the block message (optional)
 *   HAROLD_MODEL_GATE=off    turns the gate off
 * Read from the environment, ~/.harold/env, then harold/settings.env.
 *
 * Rules (exit 2 with the reason on stderr blocks the tool; exit 0 allows):
 *   1. A session-spawning tool (today: a *create_session tool from claude-code-remote): a model must be named;
 *      a model matching HAROLD_EXPENSIVE_MODELS needs the HAROLD_EXPENSIVE_TAG tag.
 *   2. A helper-agent tool (Agent or Task): a model must be named, unless it is a fork (forks always run on the
 *      caller's model). Any named model is allowed: a costly helper for a short judgment call is a choice.
 *   3. Anything else, and anything unparseable: allowed (fails open).
 */
'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');

function settingFrom(text, name) {
  const m = String(text).match(new RegExp(`^\\s*(?:export\\s+)?${name}\\s*=\\s*(?:"([^"\\n]*)"|'([^'\\n]*)'|([^\\s#\\n]*))`, 'm'));
  return m ? (m[1] ?? m[2] ?? m[3] ?? '').trim() : '';
}
function setting(name) {
  const v = process.env[name];
  if (v !== undefined && v.trim() !== '') return v.trim();
  const files = [process.env.HAROLD_ENV_FILE || path.join(os.homedir(), '.harold/env')];
  for (const base of [process.env.HAROLD_ROOT, process.env.CLAUDE_PROJECT_DIR, process.cwd()].filter(Boolean)) files.push(path.join(base, 'harold/settings.env'));
  for (const f of files) { try { const s = settingFrom(fs.readFileSync(f, 'utf8'), name); if (s) return s; } catch (_) {} }
  return '';
}
function config(get = setting) {
  return {
    expensive: get('HAROLD_EXPENSIVE_MODELS').split(',').map(s => s.trim().toLowerCase()).filter(Boolean),
    tag: get('HAROLD_EXPENSIVE_TAG') || 'allow-expensive',
    worker: get('HAROLD_WORKER_MODEL'),
  };
}

// Returns a block reason, or '' to allow.
function check(hook, cfg = config()) {
  if (!hook || typeof hook !== 'object') return '';
  const name = String(hook.tool_name || hook.toolName || '');
  let input = hook.tool_input || hook.toolArgs || hook.toolInput || hook.args;
  if (typeof input === 'string') { try { input = JSON.parse(input); } catch (_) { return ''; } }
  if (!input || typeof input !== 'object') input = {};
  const model = typeof input.model === 'string' ? input.model.trim() : '';
  const suggest = cfg.worker ? `Name the worker model ("${cfg.worker}")` : 'Name the model it should run on';
  if (/claude-code-remote/.test(name) && /create_session$/.test(name)) {
    if (!model) return `⛔ Harold model gate: this new session names no model, so it would inherit this session's. ${suggest}.`;
    const hit = cfg.expensive.find(e => model.toLowerCase().includes(e));
    if (hit) {
      const tags = Array.isArray(input.tags) ? input.tags.map(String) : [];
      if (!tags.includes(cfg.tag)) return `⛔ Harold model gate: "${model}" is on this workspace's costly list (HAROLD_EXPENSIVE_MODELS). ${suggest}, or add the tag "${cfg.tag}" if this short session needs it.`;
    }
    return '';
  }
  if (name === 'Agent' || name === 'Task') {
    if (String(input.subagent_type || '') === 'fork') return '';
    if (!model) return `⛔ Harold model gate: this helper names no model, so it would inherit this session's. ${suggest}. (A fork is exempt.)`;
  }
  return '';
}

module.exports = { check, config };
if (require.main === module) {
  try {
    if (/^(off|0|false|no)$/i.test(setting('HAROLD_MODEL_GATE'))) process.exit(0);
    let raw = ''; try { raw = fs.readFileSync(0, 'utf8'); } catch (_) {}
    let hook = null; try { hook = JSON.parse(raw); } catch (_) {}
    const why = check(hook);
    if (why) { console.error(why); process.exit(2); }
  } catch (_) {}
  process.exit(0);
}
